<%- include('../layouts/header') %>

<div class="container-fluid p-0">
  <!-- Project Banner / Header -->
  <div class="card shadow-sm mb-4 border-0">
    <div class="card-body p-4">
      <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
        <div>
          <div class="d-flex align-items-center gap-2 mb-2">
            <span class="badge bg-secondary-subtle text-secondary border font-monospace fs-6"><%= project.code %></span>
            
            <% if (project.status === 'in_progress') { %>
              <span class="badge badge-status-in_progress fs-6">Đang triển khai</span>
            <% } else if (project.status === 'planning') { %>
              <span class="badge badge-status-planning fs-6">Kế hoạch</span>
            <% } else if (project.status === 'completed') { %>
              <span class="badge badge-status-completed fs-6">Đã hoàn tất</span>
            <% } else { %>
              <span class="badge badge-status-on_hold fs-6">Tạm dừng</span>
            <% } %>

            <% if (project.priority === 'urgent') { %>
              <span class="badge badge-priority-urgent">Khẩn cấp</span>
            <% } else if (project.priority === 'high') { %>
              <span class="badge badge-priority-high">Ưu tiên cao</span>
            <% } %>
          </div>
          <h2 class="h3 fw-bold mb-2"><%= project.name %></h2>
          <p class="text-muted mb-3" style="max-width: 800px;"><%= project.description || 'Chưa có mô tả cho dự án này.' %></p>
          
          <div class="d-flex flex-wrap gap-4 text-muted small">
            <div><i class="bi bi-person me-1"></i>Người tạo: <strong><%= project.creator_name %></strong></div>
            <div>
              <i class="bi bi-calendar3 me-1"></i>
              Thời gian: 
              <%= project.start_date ? new Date(project.start_date).toLocaleDateString('vi-VN') : 'N/A' %> 
              &rarr; 
              <%= project.end_date ? new Date(project.end_date).toLocaleDateString('vi-VN') : 'Chưa định' %>
            </div>
            <div>
              <i class="bi bi-cash-stack me-1"></i>
              Ngân sách: <strong><%= Number(project.budget || 0).toLocaleString('vi-VN') %> VNĐ</strong>
            </div>
          </div>
        </div>

        <!-- Action Buttons -->
        <div class="d-flex flex-wrap gap-2">
          <% if (currentUser.role === 'admin' || currentUser.role === 'manager' || members.some(m => m.user_id === currentUser.id)) { %>
            <button type="button" class="btn btn-primary d-flex align-items-center gap-1 shadow-sm" data-bs-toggle="modal" data-bs-target="#addTaskModal">
              <i class="bi bi-plus-lg"></i>
              <span>Thêm Task</span>
            </button>
          <% } %>

          <% if (currentUser.role === 'admin' || currentUser.role === 'manager') { %>
            <button type="button" class="btn btn-outline-secondary d-flex align-items-center gap-1 shadow-sm" data-bs-toggle="modal" data-bs-target="#addMemberModal">
              <i class="bi bi-person-plus"></i>
              <span>Thêm Thành viên</span>
            </button>
            <a href="/projects/<%= project.id %>/edit" class="btn btn-outline-primary d-flex align-items-center gap-1 shadow-sm">
              <i class="bi bi-pencil"></i>
              <span>Sửa</span>
            </a>
          <% } %>
        </div>
      </div>

      <!-- Project Progress Bar -->
      <div class="mt-4 pt-3 border-top">
        <div class="d-flex justify-content-between align-items-center mb-1">
          <span class="small fw-semibold text-muted">Tiến độ dự án</span>
          <span class="small fw-bold text-primary"><%= project.progress %>% hoàn thành (<%= project.taskStats.done || 0 %>/<%= project.taskStats.total || 0 %> tasks)</span>
        </div>
        <div class="progress" style="height: 10px;">
          <div class="progress-bar <%= project.progress === 100 ? 'bg-success' : 'bg-primary' %>" role="progressbar" style="width: <%= project.progress %>%;"></div>
        </div>
      </div>
    </div>
  </div>

  <!-- Tabs Navigation -->
  <ul class="nav nav-pills mb-4 gap-2" id="projectTab" role="tablist">
    <li class="nav-item" role="presentation">
      <button class="nav-link active px-4 py-2 fw-semibold" id="kanban-tab" data-bs-toggle="tab" data-bs-target="#kanban" type="button" role="tab">
        <i class="bi bi-kanban me-1"></i> Bảng Kanban
      </button>
    </li>
    <li class="nav-item" role="presentation">
      <button class="nav-link px-4 py-2 fw-semibold" id="table-tab" data-bs-toggle="tab" data-bs-target="#table" type="button" role="tab">
        <i class="bi bi-list-task me-1"></i> Danh Sách Công Việc (<%= tasks.length %>)
      </button>
    </li>
    <li class="nav-item" role="presentation">
      <button class="nav-link px-4 py-2 fw-semibold" id="members-tab" data-bs-toggle="tab" data-bs-target="#members" type="button" role="tab">
        <i class="bi bi-people me-1"></i> Thành Viên Dự Án (<%= members.length %>)
      </button>
    </li>
  </ul>

  <!-- Tab Contents -->
  <div class="tab-content" id="projectTabContent">
    <!-- TAB 1: KANBAN BOARD -->
    <div class="tab-pane fade show active" id="kanban" role="tabpanel">
      <div class="row g-3">
        <!-- Column 1: TODO -->
        <div class="col-12 col-md-6 col-xl-3">
          <div class="kanban-column">
            <div class="d-flex justify-content-between align-items-center mb-3">
              <span class="fw-bold text-secondary text-uppercase small">
                <i class="bi bi-circle me-1"></i> Cần làm (To Do)
              </span>
              <span class="badge bg-secondary rounded-pill"><%= kanban.todo.length %></span>
            </div>

            <div class="kanban-cards-container">
              <% kanban.todo.forEach(task => { %>
                <%- include('kanban_card', { task: task, projectId: project.id }) %>
              <% }) %>
              <% if (kanban.todo.length === 0) { %>
                <div class="text-center py-4 text-muted small border border-dashed rounded">Không có task</div>
              <% } %>
            </div>
          </div>
        </div>

        <!-- Column 2: IN PROGRESS -->
        <div class="col-12 col-md-6 col-xl-3">
          <div class="kanban-column" style="background-color: #eef2ff;">
            <div class="d-flex justify-content-between align-items-center mb-3">
              <span class="fw-bold text-primary text-uppercase small">
                <i class="bi bi-play-circle me-1"></i> Đang làm (In Progress)
              </span>
              <span class="badge bg-primary rounded-pill"><%= kanban.in_progress.length %></span>
            </div>

            <div class="kanban-cards-container">
              <% kanban.in_progress.forEach(task => { %>
                <%- include('kanban_card', { task: task, projectId: project.id }) %>
              <% }) %>
              <% if (kanban.in_progress.length === 0) { %>
                <div class="text-center py-4 text-muted small border border-dashed rounded">Không có task</div>
              <% } %>
            </div>
          </div>
        </div>

        <!-- Column 3: REVIEW -->
        <div class="col-12 col-md-6 col-xl-3">
          <div class="kanban-column" style="background-color: #fffbeb;">
            <div class="d-flex justify-content-between align-items-center mb-3">
              <span class="fw-bold text-warning text-uppercase small text-dark">
                <i class="bi bi-eye me-1"></i> Chờ duyệt (Review)
              </span>
              <span class="badge bg-warning text-dark rounded-pill"><%= kanban.review.length %></span>
            </div>

            <div class="kanban-cards-container">
              <% kanban.review.forEach(task => { %>
                <%- include('kanban_card', { task: task, projectId: project.id }) %>
              <% }) %>
              <% if (kanban.review.length === 0) { %>
                <div class="text-center py-4 text-muted small border border-dashed rounded">Không có task</div>
              <% } %>
            </div>
          </div>
        </div>

        <!-- Column 4: DONE -->
        <div class="col-12 col-md-6 col-xl-3">
          <div class="kanban-column" style="background-color: #f0fdf4;">
            <div class="d-flex justify-content-between align-items-center mb-3">
              <span class="fw-bold text-success text-uppercase small">
                <i class="bi bi-check-circle me-1"></i> Hoàn tất (Done)
              </span>
              <span class="badge bg-success rounded-pill"><%= kanban.done.length %></span>
            </div>

            <div class="kanban-cards-container">
              <% kanban.done.forEach(task => { %>
                <%- include('kanban_card', { task: task, projectId: project.id }) %>
              <% }) %>
              <% if (kanban.done.length === 0) { %>
                <div class="text-center py-4 text-muted small border border-dashed rounded">Không có task</div>
              <% } %>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- TAB 2: TASKS TABLE LIST -->
    <div class="tab-pane fade" id="table" role="tabpanel">
      <div class="card shadow-sm border-0">
        <div class="card-body p-0">
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="table-light small">
                <tr>
                  <th style="width: 50px;">#</th>
                  <th>Tên công việc</th>
                  <th>Ưu tiên</th>
                  <th>Phụ trách</th>
                  <th>Hạn hoàn thành</th>
                  <th>Trạng thái</th>
                  <th class="text-end">Thao tác</th>
                </tr>
              </thead>
              <tbody>
                <% if (tasks && tasks.length > 0) { %>
                  <% tasks.forEach((t, index) => { %>
                    <% 
                      const canChangeStatus = currentUser.role === 'admin' || currentUser.role === 'manager' || t.assigned_to === currentUser.id || t.created_by === currentUser.id;
                      const canEdit = currentUser.role === 'admin' || currentUser.role === 'manager' || t.created_by === currentUser.id;
                      const canDelete = currentUser.role === 'admin' || currentUser.role === 'manager' || t.created_by === currentUser.id;
                    %>
                    <tr>
                      <td class="text-muted"><%= index + 1 %></td>
                      <td>
                        <a href="/tasks/<%= t.id %>" class="fw-semibold text-dark text-decoration-none">
                          <%= t.title %>
                        </a>
                      </td>
                      <td>
                        <% if (t.priority === 'urgent') { %>
                          <span class="badge badge-priority-urgent">Khẩn cấp</span>
                        <% } else if (t.priority === 'high') { %>
                          <span class="badge badge-priority-high">Cao</span>
                        <% } else if (t.priority === 'medium') { %>
                          <span class="badge badge-priority-medium">Trung bình</span>
                        <% } else { %>
                          <span class="badge badge-priority-low">Thấp</span>
                        <% } %>
                      </td>
                      <td>
                        <% if (t.assignee_name) { %>
                          <div class="d-flex align-items-center gap-1">
                            <div class="avatar-circle" style="width: 24px; height: 24px; font-size: 0.7rem;">
                              <%= t.assignee_name.charAt(0).toUpperCase() %>
                            </div>
                            <span class="small <%= t.assigned_to === currentUser.id ? 'fw-bold text-primary' : '' %>">
                              <%= t.assignee_name %> <%= t.assigned_to === currentUser.id ? '(Tôi)' : '' %>
                            </span>
                          </div>
                        <% } else { %>
                          <span class="text-muted small">Chưa phân công</span>
                        <% } %>
                      </td>
                      <td class="small text-muted">
                        <%= t.due_date ? new Date(t.due_date).toLocaleDateString('vi-VN') : '--' %>
                      </td>
                      <td>
                        <% if (canChangeStatus) { %>
                          <form action="/tasks/<%= t.id %>/status" method="POST" class="d-inline">
                            <input type="hidden" name="redirect_to" value="/projects/<%= project.id %>">
                            <select name="status" onchange="this.form.submit()" class="form-select form-select-sm" style="width: auto; font-size: 0.8rem;">
                              <option value="todo" <%= t.status === 'todo' ? 'selected' : '' %>>Chờ làm</option>
                              <option value="in_progress" <%= t.status === 'in_progress' ? 'selected' : '' %>>Đang làm</option>
                              <option value="review" <%= t.status === 'review' ? 'selected' : '' %>>Chờ duyệt</option>
                              <option value="done" <%= t.status === 'done' ? 'selected' : '' %>>Hoàn thành</option>
                            </select>
                          </form>
                        <% } else { %>
                          <% if (t.status === 'todo') { %>
                            <span class="badge badge-task-todo">Chờ làm</span>
                          <% } else if (t.status === 'in_progress') { %>
                            <span class="badge badge-task-in_progress">Đang làm</span>
                          <% } else if (t.status === 'review') { %>
                            <span class="badge badge-task-review">Chờ duyệt</span>
                          <% } else if (t.status === 'done') { %>
                            <span class="badge badge-task-done">Hoàn thành</span>
                          <% } %>
                        <% } %>
                      </td>
                      <td class="text-end">
                        <a href="/tasks/<%= t.id %>" class="btn btn-sm btn-outline-primary" title="Xem chi tiết"><i class="bi bi-eye"></i></a>
                        
                        <% if (canEdit) { %>
                          <a href="/tasks/<%= t.id %>/edit" class="btn btn-sm btn-outline-secondary" title="Sửa"><i class="bi bi-pencil"></i></a>
                        <% } %>

                        <% if (canDelete) { %>
                          <form action="/tasks/<%= t.id %>/delete" method="POST" class="d-inline" data-confirm="Xóa công việc này?">
                            <input type="hidden" name="redirect_to" value="/projects/<%= project.id %>">
                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa"><i class="bi bi-trash"></i></button>
                          </form>
                        <% } %>
                      </td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr>
                    <td colspan="7" class="text-center py-4 text-muted">Chưa có công việc nào trong dự án này.</td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

    <!-- TAB 3: PROJECT MEMBERS -->
    <div class="tab-pane fade" id="members" role="tabpanel">
      <div class="card shadow-sm border-0">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
          <span class="fw-bold">Thành viên tham gia dự án</span>
          <% if (currentUser.role === 'admin' || currentUser.role === 'manager') { %>
            <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#addMemberModal">
              <i class="bi bi-person-plus me-1"></i> Thêm thành viên
            </button>
          <% } %>
        </div>
        <div class="card-body p-0">
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="table-light small">
                <tr>
                  <th>Thành viên</th>
                  <th>Email</th>
                  <th>Phòng ban</th>
                  <th>Vai trò trong dự án</th>
                  <th>Ngày tham gia</th>
                  <% if (currentUser.role === 'admin' || currentUser.role === 'manager') { %>
                    <th class="text-end">Hành động</th>
                  <% } %>
                </tr>
              </thead>
              <tbody>
                <% members.forEach(m => { %>
                  <tr>
                    <td>
                      <div class="d-flex align-items-center gap-2">
                        <div class="avatar-circle bg-primary text-white">
                          <%= m.name.charAt(0).toUpperCase() %>
                        </div>
                        <div>
                          <div class="fw-semibold"><%= m.name %></div>
                          <div class="text-muted small">Hệ thống: <%= m.system_role %></div>
                        </div>
                      </div>
                    </td>
                    <td class="text-muted small"><%= m.email %></td>
                    <td class="text-muted small"><%= m.department %></td>
                    <td>
                      <% if (m.role_in_project === 'leader') { %>
                        <span class="badge bg-primary">Trưởng nhóm (Leader)</span>
                      <% } else if (m.role_in_project === 'developer') { %>
                        <span class="badge bg-info-subtle text-info border">Lập trình viên</span>
                      <% } else if (m.role_in_project === 'tester') { %>
                        <span class="badge bg-warning-subtle text-warning border">Kiểm thử (QA/QC)</span>
                      <% } else if (m.role_in_project === 'designer') { %>
                        <span class="badge bg-purple-subtle text-dark border">Thiết kế (UI/UX)</span>
                      <% } else { %>
                        <span class="badge bg-light text-secondary border">Quan sát viên</span>
                      <% } %>
                    </td>
                    <td class="text-muted small"><%= new Date(m.joined_at).toLocaleDateString('vi-VN') %></td>
                    
                    <% if (currentUser.role === 'admin' || currentUser.role === 'manager') { %>
                      <td class="text-end">
                        <form action="/projects/<%= project.id %>/members/<%= m.user_id %>/delete" method="POST" class="d-inline" data-confirm="Xóa <%= m.name %> khỏi dự án?">
                          <button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa khỏi dự án"><i class="bi bi-person-dash"></i></button>
                        </form>
                      </td>
                    <% } %>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Modal: Thêm Task mới vào dự án -->
<div class="modal fade" id="addTaskModal" tabindex="-1" aria-labelledby="addTaskModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <form action="/tasks/create" method="POST">
        <input type="hidden" name="project_id" value="<%= project.id %>">
        <input type="hidden" name="redirect_to" value="/projects/<%= project.id %>">
        <div class="modal-header">
          <h5 class="modal-title fw-bold" id="addTaskModalLabel">Thêm Công Việc Mới - <%= project.code %></h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <div class="row g-3">
            <div class="col-12">
              <label for="taskTitle" class="form-label fw-semibold">Tiêu đề công việc *</label>
              <input type="text" class="form-control" id="taskTitle" name="title" placeholder="VD: Tích hợp cổng thanh toán VNPay" required>
            </div>
            <div class="col-12">
              <label for="taskDesc" class="form-label fw-semibold">Chi tiết công việc</label>
              <textarea class="form-control" id="taskDesc" name="description" rows="3" placeholder="Mô tả các yêu cầu, lưu ý thực hiện..."></textarea>
            </div>
            <div class="col-md-4">
              <label for="taskStatus" class="form-label fw-semibold">Trạng thái</label>
              <select class="form-select" id="taskStatus" name="status">
                <option value="todo" selected>Chờ làm (To Do)</option>
                <option value="in_progress">Đang làm (In Progress)</option>
                <option value="review">Chờ duyệt (Review)</option>
                <option value="done">Hoàn thành (Done)</option>
              </select>
            </div>
            <div class="col-md-4">
              <label for="taskPriority" class="form-label fw-semibold">Độ ưu tiên</label>
              <select class="form-select" id="taskPriority" name="priority">
                <option value="low">Thấp</option>
                <option value="medium" selected>Trung bình</option>
                <option value="high">Cao</option>
                <option value="urgent">Khẩn cấp</option>
              </select>
            </div>
            <div class="col-md-4">
              <label for="taskAssign" class="form-label fw-semibold">Giao việc cho</label>
              <select class="form-select" id="taskAssign" name="assigned_to">
                <option value="">-- Chưa giao ai --</option>
                <% members.forEach(m => { %>
                  <option value="<%= m.user_id %>" <%= m.user_id === currentUser.id ? 'selected' : '' %>>
                    <%= m.name %> (<%= m.role_in_project %>)
                  </option>
                <% }) %>
              </select>
            </div>
            <div class="col-md-6">
              <label for="startDate" class="form-label fw-semibold">Ngày bắt đầu</label>
              <input type="date" class="form-control" id="startDate" name="start_date">
            </div>
            <div class="col-md-6">
              <label for="dueDate" class="form-label fw-semibold">Hạn hoàn thành</label>
              <input type="date" class="form-control" id="dueDate" name="due_date">
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Đóng</button>
          <button type="submit" class="btn btn-primary fw-semibold">Thêm công việc</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Modal: Thêm thành viên vào dự án (Chỉ Admin và Manager) -->
<% if (currentUser.role === 'admin' || currentUser.role === 'manager') { %>
  <div class="modal fade" id="addMemberModal" tabindex="-1" aria-labelledby="addMemberModalLabel" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <form action="/projects/<%= project.id %>/members" method="POST">
          <div class="modal-header">
            <h5 class="modal-title fw-bold" id="addMemberModalLabel">Thêm Thành Viên Vào Dự Án</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <div class="mb-3">
              <label for="memberSelect" class="form-label fw-semibold">Chọn nhân sự</label>
              <select class="form-select" id="memberSelect" name="user_id" required>
                <option value="">-- Chọn thành viên --</option>
                <% nonMembers.forEach(u => { %>
                  <option value="<%= u.id %>"><%= u.name %> (<%= u.email %> - <%= u.department %>)</option>
                <% }) %>
              </select>
              <% if (nonMembers.length === 0) { %>
                <div class="form-text text-muted">Tất cả nhân sự hệ thống đã có trong dự án này.</div>
              <% } %>
            </div>
            <div class="mb-3">
              <label for="roleInProject" class="form-label fw-semibold">Vai trò trong dự án</label>
              <select class="form-select" id="roleInProject" name="role_in_project">
                <option value="developer" selected>Lập trình viên (Developer)</option>
                <option value="leader">Trưởng nhóm (Leader)</option>
                <option value="tester">Kiểm thử (Tester / QA)</option>
                <option value="designer">Thiết kế (UI/UX)</option>
                <option value="viewer">Quan sát viên (Viewer)</option>
              </select>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Đóng</button>
            <button type="submit" class="btn btn-primary fw-semibold" <%= nonMembers.length === 0 ? 'disabled' : '' %>>Thêm thành viên</button>
          </div>
        </form>
      </div>
    </div>
  </div>
<% } %>

<%- include('../layouts/footer') %>
