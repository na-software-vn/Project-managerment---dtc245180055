<%- include('../layouts/header') %>

<div class="container-fluid p-0" style="max-width: 800px;">
  <div class="d-flex align-items-center justify-content-between mb-4">
    <div>
      <h3 class="fw-bold mb-1">Chỉnh Sửa Dự Án</h3>
      <p class="text-muted small mb-0">Cập nhật thông tin dự án: <%= project.code %></p>
    </div>
    <a href="/projects/<%= project.id %>" class="btn btn-outline-secondary btn-sm">
      <i class="bi bi-arrow-left me-1"></i> Quay lại chi tiết
    </a>
  </div>

  <div class="card shadow-sm border-0">
    <div class="card-body p-4">
      <form action="/projects/<%= project.id %>/edit" method="POST">
        <div class="row g-3">
          <div class="col-md-4">
            <label class="form-label fw-semibold">Mã dự án (Không thể đổi)</label>
            <input type="text" class="form-control bg-light" value="<%= project.code %>" disabled>
          </div>
          <div class="col-md-8">
            <label for="name" class="form-label fw-semibold">Tên dự án *</label>
            <input type="text" class="form-control" id="name" name="name" value="<%= project.name %>" required>
          </div>

          <div class="col-12">
            <label for="description" class="form-label fw-semibold">Mô tả dự án</label>
            <textarea class="form-control" id="description" name="description" rows="3"><%= project.description || '' %></textarea>
          </div>

          <div class="col-md-6">
            <label for="status" class="form-label fw-semibold">Trạng thái</label>
            <select class="form-select" id="status" name="status">
              <option value="planning" <%= project.status === 'planning' ? 'selected' : '' %>>Đang lập kế hoạch</option>
              <option value="in_progress" <%= project.status === 'in_progress' ? 'selected' : '' %>>Đang triển khai</option>
              <option value="on_hold" <%= project.status === 'on_hold' ? 'selected' : '' %>>Tạm dừng</option>
              <option value="completed" <%= project.status === 'completed' ? 'selected' : '' %>>Đã hoàn tất</option>
            </select>
          </div>

          <div class="col-md-6">
            <label for="priority" class="form-label fw-semibold">Mức độ ưu tiên</label>
            <select class="form-select" id="priority" name="priority">
              <option value="low" <%= project.priority === 'low' ? 'selected' : '' %>>Thấp</option>
              <option value="medium" <%= project.priority === 'medium' ? 'selected' : '' %>>Trung bình</option>
              <option value="high" <%= project.priority === 'high' ? 'selected' : '' %>>Cao</option>
              <option value="urgent" <%= project.priority === 'urgent' ? 'selected' : '' %>>Khẩn cấp</option>
            </select>
          </div>

          <div class="col-md-6">
            <label for="start_date" class="form-label fw-semibold">Ngày bắt đầu</label>
            <input type="date" class="form-control" id="start_date" name="start_date" value="<%= project.start_date ? new Date(project.start_date).toISOString().split('T')[0] : '' %>">
          </div>

          <div class="col-md-6">
            <label for="end_date" class="form-label fw-semibold">Hạn chót dự kiến</label>
            <input type="date" class="form-control" id="end_date" name="end_date" value="<%= project.end_date ? new Date(project.end_date).toISOString().split('T')[0] : '' %>">
          </div>

          <div class="col-md-12">
            <label for="budget" class="form-label fw-semibold">Ngân sách (VNĐ)</label>
            <div class="input-group">
              <input type="number" class="form-control" id="budget" name="budget" value="<%= project.budget || 0 %>" min="0" step="1000000">
              <span class="input-group-text">VNĐ</span>
            </div>
          </div>
        </div>

        <hr class="my-4">

        <div class="d-flex justify-content-end gap-2">
          <a href="/projects/<%= project.id %>" class="btn btn-outline-secondary">Hủy bỏ</a>
          <button type="submit" class="btn btn-primary px-4 fw-semibold">
            <i class="bi bi-check2-circle me-1"></i> Cập Nhật Dự Án
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('../layouts/footer') %>

