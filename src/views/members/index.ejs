<%- include('../layouts/header') %>

<div class="container-fluid p-0">
  <!-- Page Header -->
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
      <h3 class="fw-bold mb-1">Quản Lý Thành Viên & Đội Ngũ</h3>
      <p class="text-muted small mb-0">Danh sách nhân sự, phân quyền vai trò và phân công dự án</p>
    </div>
    <div>
      <% if (currentUser.role === 'admin' || currentUser.role === 'manager') { %>
        <button type="button" class="btn btn-primary d-flex align-items-center gap-1 shadow-sm" data-bs-toggle="modal" data-bs-target="#newMemberModal">
          <i class="bi bi-person-plus"></i>
          <span>Thêm Thành Viên Mới</span>
        </button>
      <% } %>
    </div>
  </div>

  <!-- Members Cards Grid -->
  <div class="row g-3">
    <% members.forEach(m => { %>
      <div class="col-12 col-md-6 col-xl-4">
        <div class="card shadow-sm h-100 border">
          <div class="card-body">
            <div class="d-flex align-items-start gap-3">
              <div class="avatar-circle avatar-lg bg-primary text-white flex-shrink-0">
                <%= m.name.charAt(0).toUpperCase() %>
              </div>
              <div class="flex-grow-1 overflow-hidden">
                <div class="d-flex justify-content-between align-items-start">
                  <h5 class="fw-bold mb-0 text-truncate"><%= m.name %></h5>
                  <div>
                    <% if (m.role === 'admin') { %>
                      <span class="badge bg-danger-subtle text-danger border">Quản trị viên (Admin)</span>
                    <% } else if (m.role === 'manager') { %>
                      <span class="badge bg-primary-subtle text-primary border">Quản lý (Manager)</span>
                    <% } else { %>
                      <span class="badge bg-secondary-subtle text-secondary border">Thành viên (Member)</span>
                    <% } %>
                  </div>
                </div>

                <div class="text-muted small mt-1 text-truncate"><i class="bi bi-envelope me-1"></i><%= m.email %></div>
                <div class="text-muted small mt-1 text-truncate"><i class="bi bi-building me-1"></i><%= m.department || 'Chưa cập nhật' %></div>
              </div>
            </div>

            <!-- Stats -->
            <div class="row g-2 text-center mt-3 pt-3 border-top">
              <div class="col-6">
                <div class="p-2 bg-light rounded">
                  <div class="fw-bold text-dark fs-5"><%= m.total_projects %></div>
                  <div class="text-muted small" style="font-size: 0.75rem;">Dự án tham gia</div>
                </div>
              </div>
              <div class="col-6">
                <div class="p-2 bg-light rounded">
                  <div class="fw-bold text-dark fs-5"><%= m.total_tasks %></div>
                  <div class="text-muted small" style="font-size: 0.75rem;">Tasks được giao</div>
                </div>
              </div>
            </div>
          </div>

          <div class="card-footer bg-light border-top-0 d-flex justify-content-between align-items-center py-2 px-3">
            <a href="/tasks?assignedTo=<%= m.id %>" class="btn btn-sm btn-link text-decoration-none p-0 small">
              <i class="bi bi-list-check me-1"></i> Xem công việc
            </a>
            
            <% if (currentUser.role === 'admin') { %>
              <div class="dropdown">
                <button class="btn btn-sm btn-light border-0" data-bs-toggle="dropdown">
                  <i class="bi bi-three-dots-vertical"></i>
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                  <li>
                    <button type="button" class="dropdown-item small" data-bs-toggle="modal" data-bs-target="#editMemberModal<%= m.id %>">
                      <i class="bi bi-pencil me-2"></i> Chỉnh sửa
                    </button>
                  </li>
                  <% if (m.id !== currentUser.id) { %>
                    <li>
                      <form action="/members/<%= m.id %>/delete" method="POST" data-confirm="Bạn chắc chắn muốn xóa thành viên <%= m.name %>?">
                        <button type="submit" class="dropdown-item small text-danger">
                          <i class="bi bi-trash me-2"></i> Xóa tài khoản
                        </button>
                      </form>
                    </li>
                  <% } %>
                </ul>
              </div>
            <% } %>
          </div>
        </div>
      </div>

      <!-- Edit Modal for each member (Only Admin) -->
      <% if (currentUser.role === 'admin') { %>
        <div class="modal fade" id="editMemberModal<%= m.id %>" tabindex="-1" aria-hidden="true">
          <div class="modal-dialog">
            <div class="modal-content">
              <form action="/members/<%= m.id %>/edit" method="POST">
                <div class="modal-header">
                  <h5 class="modal-title fw-bold">Chỉnh sửa: <%= m.name %></h5>
                  <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                  <div class="mb-3">
                    <label class="form-label fw-semibold">Họ và tên</label>
                    <input type="text" class="form-control" name="name" value="<%= m.name %>" required>
                  </div>
                  <div class="mb-3">
                    <label class="form-label fw-semibold">Email (Không đổi)</label>
                    <input type="text" class="form-control bg-light" value="<%= m.email %>" disabled>
                  </div>
                  <div class="mb-3">
                    <label class="form-label fw-semibold">Vai trò hệ thống</label>
                    <select class="form-select" name="role">
                      <option value="member" <%= m.role === 'member' ? 'selected' : '' %>>Thành viên (Member)</option>
                      <option value="manager" <%= m.role === 'manager' ? 'selected' : '' %>>Quản lý (Manager)</option>
                      <option value="admin" <%= m.role === 'admin' ? 'selected' : '' %>>Quản trị viên (Admin)</option>
                    </select>
                  </div>
                  <div class="mb-3">
                    <label class="form-label fw-semibold">Phòng ban</label>
                    <input type="text" class="form-control" name="department" value="<%= m.department || '' %>">
                  </div>
                </div>
                <div class="modal-footer">
                  <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Đóng</button>
                  <button type="submit" class="btn btn-primary fw-semibold">Cập nhật</button>
                </div>
              </form>
            </div>
          </div>
        </div>
      <% } %>
    <% }) %>
  </div>
</div>

<!-- Modal: Thêm thành viên mới (Chỉ Admin và Manager) -->
<% if (currentUser.role === 'admin' || currentUser.role === 'manager') { %>
  <div class="modal fade" id="newMemberModal" tabindex="-1" aria-labelledby="newMemberModalLabel" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <form action="/members/create" method="POST">
          <div class="modal-header">
            <h5 class="modal-title fw-bold" id="newMemberModalLabel">Thêm Thành Viên Mới</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <div class="mb-3">
              <label for="newMemName" class="form-label fw-semibold">Họ và tên *</label>
              <input type="text" class="form-control" id="newMemName" name="name" placeholder="Nguyễn Văn B" required>
            </div>
            <div class="mb-3">
              <label for="newMemEmail" class="form-label fw-semibold">Email đăng nhập *</label>
              <input type="email" class="form-control" id="newMemEmail" name="email" placeholder="b.nguyen@example.com" required>
            </div>
            <div class="mb-3">
              <label for="newMemPassword" class="form-label fw-semibold">Mật khẩu ban đầu *</label>
              <input type="password" class="form-control" id="newMemPassword" name="password" placeholder="Tối thiểu 6 ký tự" minlength="6" required value="123456">
            </div>
            <div class="mb-3">
              <label for="newMemRole" class="form-label fw-semibold">Vai trò hệ thống</label>
              <select class="form-select" id="newMemRole" name="role">
                <option value="member" selected>Thành viên (Member)</option>
                <option value="manager">Quản lý (Manager)</option>
                <option value="admin">Quản trị viên (Admin)</option>
              </select>
            </div>
            <div class="mb-3">
              <label for="newMemDept" class="form-label fw-semibold">Phòng ban</label>
              <input type="text" class="form-control" id="newMemDept" name="department" placeholder="Kỹ thuật phần mềm">
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
            <button type="submit" class="btn btn-primary fw-semibold">Tạo tài khoản</button>
          </div>
        </form>
      </div>
    </div>
  </div>
<% } %>

<%- include('../layouts/footer') %>
