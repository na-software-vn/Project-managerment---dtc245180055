<aside class="sidebar d-flex flex-column flex-shrink-0 text-white p-3">
  <a href="/dashboard" class="d-flex align-items-center mb-3 mb-md-0 me-md-auto text-white text-decoration-none px-2">
    <i class="bi bi-kanban-fill fs-3 text-primary me-2"></i>
    <span class="fs-5 fw-bold tracking-tight">Project Manager</span>
  </a>
  <hr class="text-secondary opacity-50 my-3">
  
  <ul class="nav nav-pills flex-column mb-auto">
    <li class="nav-item">
      <a href="/dashboard" class="nav-link <%= currentPath === '/dashboard' ? 'active' : '' %>">
        <i class="bi bi-speedometer2"></i>
        <span>Bảng điều khiển</span>
      </a>
    </li>
    <li>
      <a href="/projects" class="nav-link <%= currentPath.startsWith('/projects') ? 'active' : '' %>">
        <i class="bi bi-folder2-open"></i>
        <span>Quản lý Dự án</span>
      </a>
    </li>
    <li>
      <a href="/tasks" class="nav-link <%= currentPath.startsWith('/tasks') ? 'active' : '' %>">
        <i class="bi bi-check2-square"></i>
        <span>Quản lý Công việc</span>
      </a>
    </li>
    <% if (currentUser && (currentUser.role === 'admin' || currentUser.role === 'manager')) { %>
    <li>
      <a href="/members" class="nav-link <%= currentPath.startsWith('/members') ? 'active' : '' %>">
        <i class="bi bi-people"></i>
        <span>Thành viên</span>
      </a>
    </li>
    <% } %>
  </ul>



  <hr class="text-secondary opacity-50 my-3">

  <div class="px-2 pb-2">
    <div class="d-flex align-items-center justify-content-between text-muted small">
      <span>Phiên bản v1.0</span>
      <span class="badge bg-success-subtle text-success">Online</span>
    </div>
  </div>
</aside>

