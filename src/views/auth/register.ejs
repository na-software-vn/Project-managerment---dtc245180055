<%- include('../layouts/header') %>

<div class="min-vh-100 d-flex align-items-center justify-content-center bg-light py-5">
  <div class="container" style="max-width: 480px;">
    <!-- Logo & Title -->
    <div class="text-center mb-4">
      <div class="d-inline-flex p-3 bg-primary bg-opacity-10 text-primary rounded-circle mb-3">
        <i class="bi bi-person-plus-fill fs-1"></i>
      </div>
      <h3 class="fw-bold">Tạo Tài Khoản Mới</h3>
      <p class="text-muted">Đăng ký để tham gia quản lý dự án cùng đội ngũ</p>
    </div>

    <% if (errorMsg && errorMsg.length > 0) { %>
      <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        <%= errorMsg %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% } %>

    <div class="card shadow-sm border-0">
      <div class="card-body p-4">
        <form action="/auth/register" method="POST">
          <div class="mb-3">
            <label for="name" class="form-label fw-semibold">Họ và tên *</label>
            <input type="text" class="form-control" id="name" name="name" placeholder="Nguyễn Văn A" required>
          </div>

          <div class="mb-3">
            <label for="email" class="form-label fw-semibold">Email *</label>
            <input type="email" class="form-control" id="email" name="email" placeholder="example@email.com" required>
          </div>

          <div class="row g-2 mb-3">
            <div class="col-md-6">
              <label for="role" class="form-label fw-semibold">Vai trò</label>
              <select class="form-select" id="role" name="role">
                <option value="member" selected>Thành viên (Member)</option>
                <option value="manager">Quản lý (Manager)</option>
              </select>
            </div>
            <div class="col-md-6">
              <label for="department" class="form-label fw-semibold">Phòng ban</label>
              <input type="text" class="form-control" id="department" name="department" placeholder="Kỹ thuật, Thiết kế...">
            </div>
          </div>

          <div class="mb-3">
            <label for="password" class="form-label fw-semibold">Mật khẩu (ít nhất 6 ký tự) *</label>
            <input type="password" class="form-control" id="password" name="password" placeholder="••••••••" minlength="6" required>
          </div>

          <div class="mb-3">
            <label for="confirm_password" class="form-label fw-semibold">Xác nhận mật khẩu *</label>
            <input type="password" class="form-control" id="confirm_password" name="confirm_password" placeholder="••••••••" minlength="6" required>
          </div>

          <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">
            <i class="bi bi-check2-circle me-1"></i> Hoàn tất đăng ký
          </button>
        </form>
      </div>
      <div class="card-footer bg-light text-center py-3 border-0">
        <span class="text-muted small">Đã có tài khoản?</span>
        <a href="/auth/login" class="small fw-semibold text-decoration-none ms-1">Đăng nhập</a>
      </div>
    </div>
  </div>
</div>

<%- include('../layouts/footer') %>

