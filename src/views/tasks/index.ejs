<%- include('../layouts/header') %>

<div class="container-fluid p-0">
  <!-- Page Header -->
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
      <h3 class="fw-bold mb-1">Quản Lý Công Việc (Tasks)</h3>
      <p class="text-muted small mb-0">Theo dõi, lọc và phân công toàn bộ công việc trên các dự án</p>
    </div>
    <div>
      <% if (currentUser.role === 'admin' || currentUser.role === 'manager') { %>
        <a href="/tasks/create" class="btn btn-primary d-flex align-items-center gap-1 shadow-sm">
          <i class="bi bi-plus-lg"></i>
          <span>Tạo Công Việc Mới</span>
        </a>
      <% } %>
    </div>
  </div>

  <!-- Filter Card -->
  <div class="card shadow-sm mb-4">
    <div class="card-body p-3">
      <form action="/tasks" method="GET" class="row g-2 align-items-center">
        <!-- Search -->
        <div class="col-12 col-md-3">
          <input type="text" name="search" class="form-control form-control-sm" placeholder="Tìm theo tên công việc..." value="<%= filters.search %>">
        </div>

        <!-- Project Filter -->
        <div class="col-12 col-sm-6 col-md-2">
          <select name="projectId" class="form-select form-select-sm" onchange="this.form.submit()">
            <option value="">Tất cả dự án</option>
            <% projects.forEach(p => { %>
              <option value="<%= p.id %>" <%= filters.projectId == p.id ? 'selected' : '' %>><%= p.code %> - <%= p.name %></option>
            <% }) %>
          </select>
        </div>

        <!-- Status Filter -->
        <div class="col-12 col-sm-6 col-md-2">
          <select name="status" class="form-select form-select-sm" onchange="this.form.submit()">
            <option value="all" <%= filters.status === 'all' ? 'selected' : '' %>>Tất cả trạng thái</option>
            <option value="todo" <%= filters.status === 'todo' ? 'selected' : '' %>>Chờ làm (To Do)</option>
            <option value="in_progress" <%= filters.status === 'in_progress' ? 'selected' : '' %>>Đang làm (In Progress)</option>
            <option value="review" <%= filters.status === 'review' ? 'selected' : '' %>>Chờ duyệt (Review)</option>
            <option value="done" <%= filters.status === 'done' ? 'selected' : '' %>>Hoàn thành (Done)</option>
          </select>
        </div>

        <!-- Priority Filter -->
        <div class="col-12 col-sm-6 col-md-2">
          <select name="priority" class="form-select form-select-sm" onchange="this.form.submit()">
            <option value="all" <%= filters.priority === 'all' ? 'selected' : '' %>>Tất cả mức ưu tiên</option>
            <option value="urgent" <%= filters.priority === 'urgent' ? 'selected' : '' %>>Khẩn cấp</option>
            <option value="high" <%= filters.priority === 'high' ? 'selected' : '' %>>Cao</option>
            <option value="medium" <%= filters.priority === 'medium' ? 'selected' : '' %>>Trung bình</option>
            <option value="low" <%= filters.priority === 'low' ? 'selected' : '' %>>Thấp</option>
          </select>
        </div>

        <!-- Assignee Filter -->
        <div class="col-12 col-sm-6 col-md-2">
          <select name="assignedTo" class="form-select form-select-sm" onchange="this.form.submit()">
            <option value="all" <%= filters.assignedTo === 'all' ? 'selected' : '' %>>Tất cả người phụ trách</option>
            <% users.forEach(u => { %>
              <option value="<%= u.id %>" <%= filters.assignedTo == u.id ? 'selected' : '' %>><%= u.name %></option>
            <% }) %>
          </select>
        </div>

        <div class="col-12 col-md-1 d-flex gap-1">
          <button type="submit" class="btn btn-sm btn-primary w-100">Lọc</button>
          <% if (filters.search || filters.projectId || filters.status !== 'all' || filters.priority !== 'all' || filters.assignedTo !== 'all') { %>
            <a href="/tasks" class="btn btn-sm btn-outline-secondary" title="Đặt lại"><i class="bi bi-x-lg"></i></a>
          <% } %>
        </div>
      </form>
    </div>
  </div>

  <!-- Tasks Table -->
  <div class="card shadow-sm border-0">
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light small">
            <tr>
              <th style="width: 50px;">#</th>
              <th>Tiêu đề công việc</th>
              <th>Dự án</th>
              <th>Mức ưu tiên</th>
              <th>Người phụ trách</th>
              <th>Hạn chót</th>
              <th>Trạng thái</th>
              <th class="text-end">Thao tác</th>
            </tr>
          </thead>
          <tbody>
            <% if (tasks && tasks.length > 0) { %>
              <% tasks.forEach((t, index) => { %>
                <% 
                  const canChangeStatus = currentUser.role === 'admin' || currentUser.role === 'manager' || t.assigned_to === currentUser.id || t.created_by === currentUser.id;
                  const canEdit = currentUser.role === 'admin' || currentUser.role === 'manager' || t.created_by === currentUser.id;
                  const canDelete = currentUser.role === 'admin' || currentUser.role === 'manager' || t.created_by === currentUser.id;
                %>
                <tr>
                  <td class="text-muted"><%= index + 1 %></td>
                  <td>
                    <a href="/tasks/<%= t.id %>" class="fw-semibold text-dark text-decoration-none">
                      <%= t.title %>
                    </a>
                    <% if (t.comments_count > 0) { %>
                      <span class="badge bg-light text-muted ms-1"><i class="bi bi-chat-left-dots"></i> <%= t.comments_count %></span>
                    <% } %>
                  </td>
                  <td>
                    <a href="/projects/<%= t.project_id %>" class="badge bg-secondary-subtle text-secondary border text-decoration-none font-monospace">
                      <%= t.project_code %>
                    </a>
                    <span class="small text-muted d-block" style="font-size: 0.75rem;"><%= t.project_name %></span>
                  </td>
                  <td>
                    <% if (t.priority === 'urgent') { %>
                      <span class="badge badge-priority-urgent">Khẩn cấp</span>
                    <% } else if (t.priority === 'high') { %>
                      <span class="badge badge-priority-high">Cao</span>
                    <% } else if (t.priority === 'medium') { %>
                      <span class="badge badge-priority-medium">Trung bình</span>
                    <% } else { %>
                      <span class="badge badge-priority-low">Thấp</span>
                    <% } %>
                  </td>
                  <td>
                    <% if (t.assignee_name) { %>
                      <div class="d-flex align-items-center gap-2">
                        <div class="avatar-circle" style="width: 26px; height: 26px; font-size: 0.75rem;">
                          <%= t.assignee_name.charAt(0).toUpperCase() %>
                        </div>
                        <span class="small <%= t.assigned_to === currentUser.id ? 'fw-bold text-primary' : '' %>">
                          <%= t.assignee_name %> <%= t.assigned_to === currentUser.id ? '(Tôi)' : '' %>
                        </span>
                      </div>
                    <% } else { %>
                      <span class="text-muted small">-- Chưa giao --</span>
                    <% } %>
                  </td>
                  <td class="small">
                    <% if (t.due_date) { %>
                      <% const isOverdue = new Date(t.due_date) < new Date() && t.status !== 'done'; %>
                      <span class="<%= isOverdue ? 'text-danger fw-bold' : 'text-muted' %>">
                        <%= new Date(t.due_date).toLocaleDateString('vi-VN') %>
                        <% if (isOverdue) { %>
                          <i class="bi bi-exclamation-triangle-fill ms-1" title="Đã quá hạn!"></i>
                        <% } %>
                      </span>
                    <% } else { %>
                      <span class="text-muted">--</span>
                    <% } %>
                  </td>
                  <td>
                    <% if (canChangeStatus) { %>
                      <!-- Cho phép thay đổi nếu là Admin, Manager, hoặc người được giao việc -->
                      <form action="/tasks/<%= t.id %>/status" method="POST" class="d-inline">
                        <input type="hidden" name="redirect_to" value="/tasks">
                        <select name="status" onchange="this.form.submit()" class="form-select form-select-sm" style="width: auto; font-size: 0.8rem;">
                          <option value="todo" <%= t.status === 'todo' ? 'selected' : '' %>>Chờ làm</option>
                          <option value="in_progress" <%= t.status === 'in_progress' ? 'selected' : '' %>>Đang làm</option>
                          <option value="review" <%= t.status === 'review' ? 'selected' : '' %>>Chờ duyệt</option>
                          <option value="done" <%= t.status === 'done' ? 'selected' : '' %>>Hoàn thành</option>
                        </select>
                      </form>
                    <% } else { %>
                      <!-- Nếu là thành viên khác, chỉ hiển thị trạng thái tĩnh, không được đổi -->
                      <% if (t.status === 'todo') { %>
                        <span class="badge badge-task-todo">Chờ làm</span>
                      <% } else if (t.status === 'in_progress') { %>
                        <span class="badge badge-task-in_progress">Đang làm</span>
                      <% } else if (t.status === 'review') { %>
                        <span class="badge badge-task-review">Chờ duyệt</span>
                      <% } else if (t.status === 'done') { %>
                        <span class="badge badge-task-done">Hoàn thành</span>
                      <% } %>
                    <% } %>
                  </td>
                  <td class="text-end">
                    <a href="/tasks/<%= t.id %>" class="btn btn-sm btn-outline-primary" title="Xem chi tiết"><i class="bi bi-eye"></i></a>
                    
                    <% if (canEdit) { %>
                      <a href="/tasks/<%= t.id %>/edit" class="btn btn-sm btn-outline-secondary" title="Sửa"><i class="bi bi-pencil"></i></a>
                    <% } %>

                    <% if (canDelete) { %>
                      <form action="/tasks/<%= t.id %>/delete" method="POST" class="d-inline" data-confirm="Bạn chắc chắn muốn xóa công việc này?">
                        <input type="hidden" name="redirect_to" value="/tasks">
                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa"><i class="bi bi-trash"></i></button>
                      </form>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="8" class="text-center py-5 text-muted">
                  <i class="bi bi-clipboard-x fs-1 d-block mb-2 text-secondary"></i>
                  Không tìm thấy công việc nào phù hợp với bộ lọc.
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<%- include('../layouts/footer') %>
