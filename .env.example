# Application Port & Environment
PORT=5000
NODE_ENV=production

# Database Configuration (Yêu cầu mật khẩu mạnh tối thiểu 16 ký tự, gồm chữ hoa, thường, số)
DB_HOST=pm_mysql
DB_PORT=3306
DB_USER=pm_user
DB_PASSWORD=YourStrongDatabasePasswordHere_Min16Chars
MYSQL_USER=pm_user
MYSQL_PASSWORD=YourStrongDatabasePasswordHere_Min16Chars
MYSQL_ROOT_PASSWORD=YourStrongRootPasswordHere_Min16Chars
DB_NAME=project_manager_db

# Session Secret (Chuỗi ngẫu nhiên tối thiểu 32 - 64 ký tự)
SESSION_SECRET=YourCryptographicallyStrongSecretKeyHere_64Chars

# Grafana Admin Credentials
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=YourStrongGrafanaAdminPassword_Min16Chars
